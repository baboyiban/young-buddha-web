# ===========================================
# Backend Sensitive Configuration Template
# ===========================================
# 이 파일을 복사해서 .env 파일을 만드세요: cp .env.example .env
# 그리고 실제 값들로 교체하세요

# Google OAuth2 설정
# Google Cloud Console에서 OAuth2 클라이언트 ID 생성 후 입력
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# JWT 설정 (openssl rand -base64 32 명령어로 생성)
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long

# 데이터베이스 설정
DATABASE_URL=sqlite:./data.db

# 공통 설정은 루트 .env에서 상속받음