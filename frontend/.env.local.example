# 개발 환경에서 목업 인증 사용 여부
# 이 값을 true로 설정하면 목업 인증을 사용합니다
# false이거나 설정하지 않으면 실제 백엔드 API를 사용합니다
NEXT_PUBLIC_USE_MOCK_AUTH=false

# 백엔드 API URL (개발 환경)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Docker 환경에서는 서비스명 사용
# NEXT_PUBLIC_API_URL=http://backend:8080

# Next.js 빌드 시 사용되는 백엔드 URL (Docker 환경)
BACKEND_ORIGIN=http://localhost:8080
