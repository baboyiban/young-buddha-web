{
  "name": "young-buddha-frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev": "next dev",
    "dev:with-backend": "concurrently \"cd ../backend && cargo run\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "bunx eslint .",
    "type-check": "tsc --noEmit",
    "test": "bun test --preload ./src/test/setup.tsx",
    "test:ci": "bun test --preload ./src/test/setup.ts --reporter=verbose",
    "test:watch": "bun test --preload ./src/test/setup.ts --watch",
    "test:coverage": "bun test --preload ./src/test/setup.ts --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "next": "14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^14.2.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.0.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
