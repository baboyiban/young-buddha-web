{
  "name": "young-buddha-frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev": "next dev",
    "dev:with-backend": "concurrently \"cd ../backend && cargo run\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "bunx eslint .",
    "type-check": "tsc --noEmit",
    "test": "bunx vitest --config vitest.config.ts",
    "test:ci": "bunx vitest run --config vitest.config.ts --reporter=verbose",
    "test:bun": "bun run test",
    "test:watch": "bunx vitest --watch --config vitest.config.ts",
    "test:run": "bunx vitest --run --config vitest.config.ts",
    "test:coverage": "bunx vitest --run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "next": "14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "swr": "^2.3.6",
    "tailwindcss": "^4.1.12",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^14.2.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.2",
    "eslint": "9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
