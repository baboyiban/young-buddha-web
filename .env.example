# ===========================================
# Young Buddha Web - Environment Variables
# ===========================================
# 이 파일을 복사해서 .env 파일을 만드세요: cp .env.example .env

# Shared Configuration
NODE_ENV=development
PORT=8080
HOST=localhost

# Frontend Variables (VITE_ prefix for client exposure)
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=생활소임 일정표

# Production example:
# NODE_ENV=production
# VITE_API_BASE_URL=https://your-domain.com