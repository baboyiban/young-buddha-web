# syntax=docker/dockerfile:1.7

# 빌드 스테이지
FROM --platform=linux/amd64 rust:1.89-alpine AS builder

# 빌드에 필요한 패키지 설치
RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    pkgconfig \
    ca-certificates

# 작업 디렉터리 설정
WORKDIR /app

# 실제 소스 복사 후 빌드
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release && \
    mv target/release/young-buddha-backend /app/young-buddha-backend

# 런타임 스테이지
FROM --platform=linux/amd64 alpine:3.19 AS runtime

# 런타임에 필요한 패키지 설치
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    su-exec \
    wget \
    openssl && \
    update-ca-certificates

# 애플리케이션 사용자/그룹 생성 (명시적 그룹 추가)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup -u 1001

# 작업 디렉터리 설정
WORKDIR /app

# 빌드된 바이너리 복사 (숫자 UID:GID 사용으로 그룹 인식 문제 회피)
COPY --from=builder --chown=1001:1001 /app/young-buddha-backend /app/young-buddha-backend

# 키 파일 복사
COPY keys /app/keys/

# 데이터 및 키 디렉터리 생성 및 권한 설정
RUN mkdir -p /app/data \
    && chmod -R 755 /app/data \
    && chmod -R go-rwx /app/keys || true \
    && chown -R 1001:1001 /app/data /app/keys

# 런타임 기본 환경 (조정 가능)
ENV RUST_LOG=${RUST_LOG:-info} \
    RUST_BACKTRACE=1

# 애플리케이션 실행
CMD ["/app/young-buddha-backend"]
