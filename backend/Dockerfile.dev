# syntax=docker/dockerfile:1.7

# Use the official Rust image for development
FROM --platform=linux/amd64 rust:1.89-alpine AS base

# Install necessary packages for development
RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig

# Install cargo-watch for hot-reloading
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install cargo-watch

# Set the working directory
WORKDIR /app

# Copy dependency definitions for better caching
COPY Cargo.toml Cargo.lock ./

# Create dummy source files to pre-build dependencies
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    echo "" > src/lib.rs

# Pre-build dependencies to leverage Docker cache
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release && \
    rm -rf src

# Expose the backend port
EXPOSE 8080

# Set the default command to run the development server with hot-reloading
CMD ["cargo", "watch", "-x", "run"]
