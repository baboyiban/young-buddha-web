# Backend Environment Example
# Copy to backend/.env and adjust values

# Server
PORT=8080
NODE_ENV=production

# Auth/JWT
JWT_SECRET=change-this-in-production

# Google OAuth
# 실제 운영 도메인(https)과 콜백 경로는 프록시 설정에 맞추세요.
# Nginx/프록시가 /api → /api/v1로 리라이트한다면, 외부 공개 콜백은 /api를 쓰는 것이 일반적입니다.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 외부에서 접근 가능한 콜백 URL (Google Cloud Console에 동일하게 등록 필요)
# 예) 프록시가 /api -> /api/v1로 라우팅하는 경우:
GOOGLE_REDIRECT_URI=https://young-buddha.online/api/auth/google/callback
# (직접 백엔드로 노출한다면 /api/v1/auth/google/callback 형태를 사용할 수 있습니다)

# Frontend URL (CORS/cookie 도메인 판단)
FRONTEND_URL=https://young-buddha.online

# Database
DB_PATH=./data.db

# Optional: Redis
#REDIS_URL=redis://redis:6379