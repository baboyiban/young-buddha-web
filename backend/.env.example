# Backend 공통 환경변수
# 환경별로 다른 값은 각 .env.dev 또는 .env.prod 파일에서 설정

# 데이터베이스 (DB_PATH 권장; DATABASE_URL도 지원되며 자동 정규화됨)
# DB_PATH는 컨테이너 내부 경로 기준
DB_PATH=/app/data/data.db
# DATABASE_URL=sqlite:///app/data/data.db

# JWT Secret
JWT_SECRET=your_very_secure_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# Redis (optional)
# REDIS_URL=redis://redis:6379

# 프론트엔드 URL
FRONTEND_URL=https://your-domain.com

# 로깅
RUST_LOG=info

# 서버
PORT=8080
NODE_ENV=production

# Google Sheets 통합
USER_SHEET_SPREADSHEET_ID=your_google_sheet_id_here
USER_SHEET_NAME=Sheet1

# Google 서비스 계정 키 파일 경로 (관리자 권한으로 스프레드시트 접근용)
# JSON 키 파일을 다운로드하여 keys/ 폴더에 저장
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/app/keys/service-account-key.json
