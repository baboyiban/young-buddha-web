[Unit]
Description=Young Buddha Web Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/young-buddha-web/backend
ExecStart=/home/ubuntu/young-buddha-web/backend/zig-out/bin/young-buddha-web
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
